rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && (
          request.auth.token.admin == true
          || request.auth.token.role == 'admin'
          || request.auth.token.email == 'admin@rk.com'
        );
    }

    function isValidBookingCreate() {
      return request.resource.data.keys().hasOnly([
          'barberId',
          'barberName',
          'serviceId',
          'serviceName',
          'serviceIds',
          'serviceNames',
          'customerName',
          'phone',
          'email',
          'notes',
          'date',
          'time',
          'type',
          'status',
          'price',
          'createdAt'
        ])
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 1
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.type in ['reservation', 'walkin']
        && request.resource.data.status in ['pending', 'confirmed']
        && request.resource.data.price is number;
    }

    function isValidQueueCreate() {
      return request.resource.data.keys().hasOnly([
          'barberId',
          'customerName',
          'phone',
          'position',
          'status',
          'createdAt'
        ])
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 1
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.status == 'waiting'
        && request.resource.data.position is int
        && request.resource.data.position > 0;
    }

    // Public display collections
    match /barbers/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public booking intake; admin-only lifecycle updates and reads
    match /bookings/{docId} {
      allow create: if isValidBookingCreate();
      allow read, update, delete: if isAdmin();
    }

    // Public queue intake and visibility; admin-only mutation
    match /queue/{docId} {
      allow create: if isValidQueueCreate();
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    // Deny all other collections/documents by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
